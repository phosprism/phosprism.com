# ブラウザキャッシュとセキュリティヘッダーの設定（本番サーバー用）
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    # ファイル名に内容のハッシュが付くビルド成果物は1年間キャッシュする
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <ElseIf "%{REQUEST_URI} =~ m#^/assets/# || %{REQUEST_URI} == '/favicon.ico'">
    # 画像などは差し替えがあり得るので1週間
    Header set Cache-Control "public, max-age=604800"
  </ElseIf>
  <Else>
    # HTMLなどは毎回更新を確認する
    Header set Cache-Control "no-cache"
    # 同じURLでも Accept によってHTMLとMarkdownを返し分けるため、キャッシュにそれを伝える
    Header merge Vary "Accept"
  </Else>

  # AIエージェント向けのMarkdown版（index.md）。検索結果にはHTMLのページを出す
  <FilesMatch "\.md$">
    Header set X-Robots-Tag "noindex"
  </FilesMatch>
  # Markdownのおおよそのトークン数（ビルド時に計算して、振り分けのルールで渡している）
  Header set x-markdown-tokens "%{REDIRECT_MD_TOKENS}e" env=REDIRECT_MD_TOKENS

  # 常にHTTPSで接続させる（1年間）
  Header always set Strict-Transport-Security "max-age=31536000"
  # 他サイトの iframe に埋め込ませない（クリックジャッキング対策）
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "frame-ancestors 'self'"
  # 別サイトのウィンドウとの関係を切り離す
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  # ファイルの種類を推測させない
  Header always set X-Content-Type-Options "nosniff"
  # 外部サイトへ送るリファラーをドメインだけにする
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Markdownファイルは文字コード付きの text/markdown として返す
<IfModule mod_mime.c>
  AddType "text/markdown; charset=utf-8" .md
</IfModule>

# 存在しないURLには、サイトのデザインの404ページを返す（Issue #20）
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # iOSがホーム画面のアイコンとして探す /apple-touch-icon.png に、/assets/ のアイコンを返す（Issue #20）
  RewriteRule ^apple-touch-icon(-precomposed)?\.png$ /assets/apple-touch-icon.png [L]

  # 末尾にスラッシュのないURL（/about など）は、https のスラッシュ付きURLへ301で移動する（Issue #20）
  # サーバー標準のスラッシュ補完は http:// のURLへ移動させてしまうため止めて、ここで代わりに行う
  <IfModule mod_dir.c>
    DirectorySlash Off
  </IfModule>
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1/ [R=301,L]
</IfModule>
