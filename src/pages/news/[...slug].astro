---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getCollection, render } from 'astro:content';
import { assertUniqueNewsSlugs, getNewsDescription, getNewsSlug } from '../../utils/newsSlug';
import OptimizedImage from '../../components/OptimizedImage.astro';
import { getNewsLabel } from '../../utils/newsPages';

export async function getStaticPaths() {
  const entries = await getCollection('news');
  assertUniqueNewsSlugs(entries);
  return entries.map((entry) => ({ params: { slug: getNewsSlug(entry) }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const date = entry.data.date
  .toLocaleDateString('ja-JP', { year: 'numeric', month: '2-digit', day: '2-digit' })
  .replaceAll('/', '.');
const articleTitle = entry.data.title;
const articleDescription = getNewsDescription(entry);
const articleUrl = new URL(Astro.url.pathname, Astro.site).href;
// シェア用のURL。短縮URL（npm run short-url:news で発行）があればそれを使う
const shareUrl = entry.data.shortUrl ?? articleUrl;
const xShareUrl = `https://x.com/intent/post?${new URLSearchParams({
  text: articleTitle,
  url: shareUrl,
  // Dreamy Records のアーカイブ記事だけ、当時のハッシュタグを付ける
  hashtags: getNewsLabel(entry) === 'dreamy-records' ? 'ドリレコ' : 'フォスプリ',
})}`;
---

<SiteLayout
  title={`${entry.data.title} — Phos'Prism`}
  page="news-detail"
  description={articleDescription}
  image={entry.data.image}
  redirectTo={entry.data.redirectTo}
  noindex={Boolean(entry.data.redirectTo)}
  generateOgImage={getNewsLabel(entry) === 'phosprism'}
>
  <main class="article-page">
    <a class="article-back" href="/news/">← ALL NEWS</a>
    <article>
      <header class="article-head">
        <div>
          <time datetime={entry.data.date.toISOString()}>{date}</time><span
            >{entry.data.category}</span
          >
        </div>
        <h1>{entry.data.title}</h1>
      </header>
      {
        entry.data.image && entry.data.showImage && (
          <OptimizedImage
            class="article-image"
            src={entry.data.image}
            alt={entry.data.title}
            loading="lazy"
          />
        )
      }
      <div class="article-body"><Content /></div>
      <aside
        data-markdown-skip
        class="article-share"
        aria-label="この記事をシェア"
        data-share-title={articleTitle}
        data-share-url={shareUrl}
      >
        <p>SHARE THIS ARTICLE</p>
        <div class="article-share-buttons">
          <a href={xShareUrl} target="_blank" rel="noopener noreferrer">
            <i class="fa-brands fa-x-twitter" aria-hidden="true"></i>
            <span>Xでシェア</span>
          </a>
          <button class="js-copy-article" type="button">
            <i class="fa-regular fa-copy" aria-hidden="true"></i>
            <span>タイトルとURLをコピー</span>
          </button>
          <button class="js-share-article" type="button">
            <i class="fa-solid fa-arrow-up-from-bracket" aria-hidden="true"></i>
            <span>その他のシェア</span>
          </button>
        </div>
        <p class="article-share-status" role="status" aria-live="polite"></p>
      </aside>
    </article>
    <a class="article-back article-back-bottom" href="/news/">← NEWS一覧へ戻る</a>
  </main>

  <script>
    const share = document.querySelector<HTMLElement>('.article-share');
    const copyButton = share?.querySelector<HTMLButtonElement>('.js-copy-article');
    const shareButton = share?.querySelector<HTMLButtonElement>('.js-share-article');
    const status = share?.querySelector<HTMLElement>('.article-share-status');
    const title = share?.dataset.shareTitle ?? document.title;
    const url = share?.dataset.shareUrl ?? window.location.href;
    const copyValue = `${title}\n${url}`;

    // 押したボタンの上に吹き出しを出す（読み上げは status 側で行う）
    const showStatus = (message: string, button?: HTMLButtonElement | null) => {
      if (status) {
        status.textContent = message;
        window.setTimeout(() => {
          if (status.textContent === message) status.textContent = '';
        }, 2200);
      }
      if (!button) return;
      let bubble = button.querySelector<HTMLElement>('.article-share-bubble');
      if (!bubble) {
        bubble = document.createElement('span');
        bubble.className = 'article-share-bubble';
        bubble.setAttribute('aria-hidden', 'true');
        button.append(bubble);
      }
      bubble.textContent = message;
      window.clearTimeout(Number(bubble.dataset.timer));
      bubble.classList.add('is-visible');
      bubble.dataset.timer = String(
        window.setTimeout(() => bubble?.classList.remove('is-visible'), 2200),
      );
    };

    const copyArticle = async (button?: HTMLButtonElement | null) => {
      try {
        await navigator.clipboard.writeText(copyValue);
      } catch {
        const textarea = document.createElement('textarea');
        textarea.value = copyValue;
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';
        document.body.append(textarea);
        textarea.select();
        document.execCommand('copy');
        textarea.remove();
      }
      showStatus('コピーしました', button);
    };

    copyButton?.addEventListener('click', () => copyArticle(copyButton));
    shareButton?.addEventListener('click', async () => {
      if (!navigator.share) {
        await copyArticle(shareButton);
        return;
      }
      try {
        await navigator.share({ title, text: title, url });
      } catch (error) {
        if (error instanceof DOMException && error.name === 'AbortError') return;
        showStatus('共有画面を開けませんでした', shareButton);
      }
    });
  </script>
</SiteLayout>
